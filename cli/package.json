{
  "name": "santra",
  "version": "2.0.3",
  "description": "Santra terminal coding assistant CLI",
  "private": false,
  "type": "module",
  "main": "dist/santra.mjs",
  "bin": {
    "santra": "bin/santra.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --target node --format esm --outfile dist/santra.mjs --packages bundle",
    "prepack": "bun run build",
    "postinstall": "node postinstall.js",
    "typecheck": "bunx tsc --noEmit --project tsconfig.json",
    "tui": "bun src/tui/index.tsx",
    "tui:v3": "bun src/tui_v3/index.tsx",
    "tui:v4": "bun src/tui_v4/index.tsx",
    "tui:v5": "bun src/tui_v5/index.tsx"
  },
  "dependencies": {},
  "devDependencies": {
    "@santra/core": "workspace:*",
    "@santra/shared": "workspace:*",
    "@opentui/react": "^0.1.97",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "typescript": "^6",
    "zod": "^4.3.6"
  }
}

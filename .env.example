# ─────────────────────────────────────────────────────────────
# Santra Configuration
# ─────────────────────────────────────────────────────────────

# Development mode (enables dev features)
SANTRA_DEV=1

# Default model to use (optional - overrides provider default)
SANTRA_MODEL=meta/llama-3.1-8b-instruct

# Login URL for the web auth flow (optional)
SANTRA_LOGIN_URL=http://localhost:3000/login

# Web application base URL (used for OAuth callbacks and redirects)
NEXT_PUBLIC_SANTRA_WEB_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Provider: Nvidia NIM
# ─────────────────────────────────────────────────────────────

NVIDIA_API_KEY=nvapi-your_api_key_here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROVIDER=nvidia-nim

# ─────────────────────────────────────────────────────────────
# Provider: OpenAI
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=sk-your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────
# Provider: Anthropic (Claude)
# ─────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-your_api_key_here

# ─────────────────────────────────────────────────────────────
# Web/CLI Integration
# ─────────────────────────────────────────────────────────────

WEB_ENDPOINT=http://localhost:3000/api/v1/completions

# ─────────────────────────────────────────────────────────────
# Authentication: OAuth Providers
# ─────────────────────────────────────────────────────────────

# GitHub OAuth - Get from https://github.com/settings/developers
NEXT_PUBLIC_SANTRA_GITHUB_LOGIN_URL=https://github.com/login/oauth/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost:3000/login/[token]/complete&scope=user:email

# Google OAuth - Get from https://console.cloud.google.com/
NEXT_PUBLIC_SANTRA_GOOGLE_LOGIN_URL=https://accounts.google.com/o/oauth2/v2/auth?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost:3000/login/[token]/complete&response_type=code&scope=openid%20email%20profile
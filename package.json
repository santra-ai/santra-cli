{
  "name": "santra-project",
  "version": "1.0.0",
  "description": "Santra monorepo for CLI, web, backend, and shared packages.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": "1.3.11"
  },
  "license": "Apache-2.0",
  "scripts": {
    "web": "cd web && bun run dev",
    "cli": "bun cli/index.ts",
    "tui": "bun cli/src/tui_v4/index.tsx",
    "tui:v3": "bun cli/src/tui_v3/index.tsx",
    "typecheck": "bunx tsc --noEmit --project tsconfig.json"
  },
  "workspaces": [
    "web",
    "cli",
    "core",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}

{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node", "bun"],
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@santra/shared": ["./packages/shared/index.ts"],
      "@santra/shared/*": ["./packages/shared/*"],
      "@santra/agent-runtime": ["./packages/agent-runtime/index.ts"],
      "@santra/agent-runtime/*": ["./packages/agent-runtime/*"],
      "@santra/core": ["./core/index.ts"],
      "@santra/core/*": ["./core/*"]
    }
  },
  "include": [
    "backend/**/*.ts",
    "cli/**/*.ts",
    "core/**/*.ts",
    "packages/**/*.ts",
    "tmp/**/*.ts"
  ]
}

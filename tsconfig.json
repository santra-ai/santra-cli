{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@santra/shared": ["packages/shared/index.ts"],
      "@santra/shared/*": ["packages/shared/*"],
      "@santra/agent-runtime": ["packages/agent-runtime/index.ts"],
      "@santra/agent-runtime/*": ["packages/agent-runtime/*"],
      "@santra/core": ["core/index.ts"],
      "@santra/core/*": ["core/*"]
    }
  },
  "include": ["cli/**/*.ts", "core/**/*.ts", "packages/**/*.ts"]
}
